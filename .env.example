# Server Port
PORT=3000

# Node Environment (production / development)
NODE_ENV=production

# Directory where SQLite db and uploaded icons are persisted
DATA_DIR=/data

# Comma-separated list of Tailscale logins/handles with admin editing rights
ADMIN_USERS=arvesv,your-email@example.com

# Enable dev mode to bypass Tailscale checks during local debugging
DEV_MODE=false

# Optional path to local Tailscale daemon socket for whois lookup
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
